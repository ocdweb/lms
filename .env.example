# ── Database ─────────────────────────────────────────────
# SQLite file for local/dev. For production, switch the provider in
# prisma/schema.prisma to "postgresql" and point this at your Postgres URL.
DATABASE_URL="file:./dev.db"

# ── App ──────────────────────────────────────────────────
# Public base URL used in email links
APP_URL="http://localhost:3000"
# Long random string used to sign session cookies (openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# ── Email (SMTP) ─────────────────────────────────────────
# Leave SMTP_HOST empty to log emails to the console + Email Outbox instead of sending.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Legacy Media Leave <leave@legacymedia.com>"
# Comma-separated inbox(es) that receive new leave requests.
# If empty, every active Admin user is notified.
ADMIN_NOTIFY_EMAIL=""

# ── Google Calendar ──────────────────────────────────────
# Approved leaves are written to this shared calendar using a service account.
# 1. Create a service account in Google Cloud, enable the Calendar API, download its JSON key.
# 2. Share the calendar with the service account email ("Make changes to events").
# Leave empty to disable the integration.
GOOGLE_CALENDAR_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Private key from the JSON file; keep the \n escapes, wrap in double quotes
GOOGLE_PRIVATE_KEY=""
# Timezone used for calendar events and "today"
APP_TIMEZONE="Asia/Karachi"

# ── Seed (npm run db:seed) ───────────────────────────────
# Initial admin account + password used for the seeded demo users. Change after first login.
SEED_ADMIN_EMAIL="admin@legacymedia.com"
SEED_PASSWORD="LegacyLeave!2026"
# Set to "false" to seed only leave types, holidays and the admin (no demo employees/requests)
SEED_DEMO_DATA="true"
